---
// Project cards, each linking to its detail page. Hidden while there is none.
import Reveal from '../components/Reveal.astro'
import Icon from '../components/Icon.astro'
import SectionCta from '../components/SectionCta.astro'
import { realisations, type T } from '../content'
import { pagePath } from '../lib/routes'
import { kicker, lift, sectionHead, sectionIntro, sectionTitle } from '../lib/ui'

interface Props {
  t: T
}

const { t } = Astro.props
const { realisations: section, realisation: labels, lang } = t
const dt = 'mt-3 text-[11px] font-extrabold tracking-[0.08em] text-red uppercase'
const dd = 'mt-1 text-[14.5px] leading-normal text-ink-2'
---

{realisations.length > 0 && (
  <section id={t.anchors.realisations} class="section-y" aria-labelledby="realisations-title">
    <div class="wrap">
      <Reveal class={sectionHead}>
        <h2 id="realisations-title" class={sectionTitle}>{section.title}</h2>
        <p class={sectionIntro}>{section.intro}</p>
      </Reveal>
      <div class="grid grid-cols-[repeat(auto-fit,minmax(300px,1fr))] gap-[18px]">
        {realisations.map((r, i) => {
          const p = r[lang]
          return (
            <Reveal as="article" class={`card flex flex-col px-[26px] py-7 ${lift}`} delay={(i % 3) + 1}>
              <span class={`${kicker} self-start text-ink-3`}>{p.sector}</span>
              <h3 class="mt-3 text-[22px] tracking-[-0.03em]">{p.title}</h3>
              <dl class="mt-[18px] flex-1">
                <dt class={dt}>{labels.problem}</dt>
                <dd class={dd}>{p.card.problem}</dd>
                <dt class={dt}>{labels.solution}</dt>
                <dd class={dd}>{p.card.solution}</dd>
                <dt class={dt}>{labels.result}</dt>
                <dd class={dd}>{p.card.result}</dd>
              </dl>
              <a class="mt-[22px] inline-flex items-center gap-2 border-t-[1.5px] border-line pt-4 text-sm font-extrabold text-ink transition-colors hover:text-red" href={pagePath('realisation', lang, r.slug)}>
                {section.link} <Icon name="arrow" />
              </a>
            </Reveal>
          )
        })}
      </div>
      <SectionCta cta={section.cta} lang={lang} />
    </div>
  </section>
)}
