---
import Reveal from '../components/Reveal.astro'
import Icon from '../components/Icon.astro'
import { CONTACT_EMAIL, type T } from '../content'
import { pagePath } from '../lib/routes'
import { btnPrimary, kicker } from '../lib/ui'

interface Props {
  t: T
}

const { t } = Astro.props
const { contact } = t
const label = `${kicker} mb-2 block text-ink-2`
const input = 'w-full rounded-field border-[1.5px] border-line-2 bg-pap px-[15px] py-[13px] text-[15px] text-ink transition-[border-color,box-shadow] duration-200 placeholder:text-ink-3 focus:border-red focus:shadow-[0_0_0_3px_var(--grad-glow)] focus:outline-none'
const message = 'mt-3.5 text-center text-[13.5px] font-bold'
---

<section id={t.anchors.contact} class="band section-y" aria-labelledby="contact-title">
  <div class="wrap grid grid-cols-1 items-start gap-[clamp(28px,5vw,64px)] lg:grid-cols-[0.9fr_1.1fr]">
    <Reveal class="lg:sticky lg:top-28">
      <h2 id="contact-title" class="text-[clamp(34px,5vw,56px)] tracking-[-0.04em]">{contact.title}</h2>
      <p class="mt-4 max-w-[34ch] text-[17px] text-ink-2">{contact.subtitle}</p>
      <p class="mt-3 max-w-[38ch] text-[15px] leading-[1.55] text-ink-2">{contact.next}</p>
      <p class="mt-[26px] text-[15px] text-ink-2">
        {contact.or} <a href={`mailto:${CONTACT_EMAIL}`} class="font-extrabold text-red">{CONTACT_EMAIL}</a>
      </p>
    </Reveal>

    <Reveal as="form" class="card p-[clamp(24px,3vw,34px)]" delay={1} data-contact-form data-sending={contact.sending}>
      <div class="mb-4">
        <label for="cf-name" class={label}>{contact.name}</label>
        <input id="cf-name" name="name" type="text" autocomplete="name" required placeholder={contact.name} class={input} />
      </div>
      <div class="mb-4">
        <label for="cf-company" class={label}>
          {contact.company} <span class="font-semibold tracking-normal text-ink-3 normal-case">({contact.optional})</span>
        </label>
        <input id="cf-company" name="company" type="text" autocomplete="organization" placeholder={contact.company} class={input} />
      </div>
      <div class="mb-4">
        <label for="cf-email" class={label}>{contact.email}</label>
        <input id="cf-email" name="email" type="email" autocomplete="email" required placeholder={contact.emailPlaceholder} class={input} />
      </div>
      <div class="mb-4">
        <label for="cf-msg" class={label}>{contact.message}</label>
        <textarea id="cf-msg" name="message" required placeholder={contact.messagePlaceholder} class={`${input} min-h-[118px] resize-y`}></textarea>
      </div>
      <!-- Honeypot: hidden field only bots fill in (see api/contact.js). -->
      <input type="text" name="website" autocomplete="off" tabindex="-1" aria-hidden="true" class="pointer-events-none absolute -left-[9999px] opacity-0" />
      <button type="submit" class={`${btnPrimary} mt-1.5 w-full justify-center`}>
        <span data-label>{contact.submit}</span>
        <Icon name="arrow" data-arrow />
      </button>
      <p class="mt-3.5 text-xs leading-[1.55] text-ink-3">
        {contact.privacy} <a href={pagePath('privacy', t.lang)} class="font-bold text-ink-2 underline underline-offset-2 hover:text-red">{contact.privacyLink}</a>
      </p>
      <p class={`${message} text-ok`} role="status" hidden data-ok>{contact.success}</p>
      <p class={`${message} text-red`} role="alert" hidden data-err>
        {contact.error} <a href={`mailto:${CONTACT_EMAIL}`} class="font-bold text-inherit">{CONTACT_EMAIL}</a>
      </p>
    </Reveal>
  </div>
</section>

<script>
  const form = document.querySelector<HTMLFormElement>('[data-contact-form]')
  if (form) {
    const button = form.querySelector<HTMLButtonElement>('button[type="submit"]')!
    const label = button.querySelector('[data-label]')!
    const arrow = button.querySelector<SVGElement>('[data-arrow]')!
    const ok = form.querySelector<HTMLElement>('[data-ok]')!
    const err = form.querySelector<HTMLElement>('[data-err]')!
    const submitText = label.textContent
    const sendingText = form.dataset.sending ?? ''

    const setStatus = (status: 'idle' | 'sending' | 'ok' | 'err') => {
      button.disabled = status === 'sending'
      label.textContent = status === 'sending' ? sendingText : submitText
      arrow.style.display = status === 'sending' ? 'none' : ''
      ok.hidden = status !== 'ok'
      err.hidden = status !== 'err'
    }

    form.addEventListener('submit', async (e) => {
      e.preventDefault()
      setStatus('sending')
      const data = new FormData(form)
      const field = (name: string) => String(data.get(name) ?? '').trim()
      const payload = {
        name: field('name'),
        company: field('company'),
        email: field('email'),
        message: field('message'),
        website: field('website'), // honeypot
      }
      try {
        const res = await fetch('/api/contact', {
          method: 'POST',
          headers: { Accept: 'application/json', 'Content-Type': 'application/json' },
          body: JSON.stringify(payload),
        })
        if (!res.ok) throw new Error(String(res.status))
        setStatus('ok')
        form.reset()
      } catch {
        setStatus('err')
      }
    })
  }
</script>
