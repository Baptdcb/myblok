---
import Reveal from '../components/Reveal.astro'
import type { T } from '../content'
import { lift, sectionHead, sectionIntro, sectionTitle, tag } from '../lib/ui'

interface Props {
  t: T
}

const { t } = Astro.props
const { offer } = t
---

<section id={t.anchors.offer} class="section-y" aria-labelledby="offer-title">
  <div class="wrap">
    <Reveal class={sectionHead}>
      <h2 id="offer-title" class={sectionTitle}>{offer.title}</h2>
      <p class={sectionIntro}>{offer.intro}</p>
    </Reveal>
    <div class="grid grid-cols-1 gap-[18px] md:grid-cols-2">
      {offer.blocks.map((b, i) => (
        <Reveal class={`card flex flex-col px-[26px] py-7 ${lift}`} delay={i + 1}>
          <div class="flex items-baseline justify-between gap-4">
            <span class={tag}>{b.tag}</span>
            <span class="font-display text-sm font-extrabold tracking-[-0.02em] text-ink-3" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
          </div>
          <h3 class="mt-3 text-[22px] tracking-[-0.03em]">{b.title}</h3>
          <p class="mt-3 flex-1 text-[15.5px] leading-normal text-ink-2">{b.desc}</p>
          <p class="mt-5 border-l-2 border-red pl-3 text-sm leading-[1.5] font-semibold text-ink">{b.example}</p>
        </Reveal>
      ))}
    </div>
    <Reveal class="mt-[clamp(28px,4vw,40px)] grid grid-cols-1 gap-7 rounded-card border-[1.5px] border-ink bg-pap-2 p-[clamp(22px,3vw,34px)]" delay={2}>
      <div class="flex flex-wrap items-baseline justify-between gap-x-8 gap-y-2">
        <span class="font-display text-[clamp(22px,2.4vw,28px)] font-extrabold tracking-[-0.03em]">{offer.pricing.label}</span>
        <p class="max-w-[52ch] text-sm leading-[1.5] text-ink-2">{offer.pricing.note}</p>
      </div>
      <div class="grid grid-cols-2 gap-x-4 gap-y-6 md:grid-cols-4">
        {offer.pricing.items.map((item) => (
          <div class="flex flex-col gap-1.5 border-l-2 border-line pl-4">
            <span class="text-[13px] leading-[1.3] font-semibold text-ink-2">{item.label}</span>
            <strong class="font-display text-[clamp(22px,2.6vw,30px)] leading-[1.05] tracking-[-0.03em] sm:whitespace-nowrap">{item.price}</strong>
          </div>
        ))}
      </div>
    </Reveal>
  </div>
</section>
