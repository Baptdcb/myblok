---
import Reveal from '../components/Reveal.astro'
import SectionCta from '../components/SectionCta.astro'
import type { T } from '../content'
import { sectionHead, sectionIntro, sectionTitle, tag } from '../lib/ui'

interface Props {
  t: T
}

const { t } = Astro.props
const { process } = t
---

<section id={t.anchors.process} class="band section-y" aria-labelledby="process-title">
  <div class="wrap">
    <Reveal class={sectionHead}>
      <h2 id="process-title" class={sectionTitle}>{process.title}</h2>
      <p class={sectionIntro}>{process.intro}</p>
    </Reveal>
    <div class="grid grid-cols-1 gap-x-8 gap-y-10 md:grid-cols-2 lg:grid-cols-4">
      {process.steps.map((s, i) => (
        <Reveal class="step relative flex flex-col border-t border-line pt-5" delay={(i % 4) + 1}>
          <span class="font-display text-[clamp(34px,3.6vw,44px)] leading-none font-extrabold tracking-[-0.04em] text-grad">{String(i + 1).padStart(2, '0')}</span>
          <h3 class="mt-4 text-xl tracking-[-0.025em]">{s.name}</h3>
          <p class="mt-2 text-[15px] leading-[1.55] text-ink-2">{s.desc}</p>
          {s.badge && (
            <span class={`${tag} mt-4 self-start rounded-full border border-red px-2.5 py-1`}>{s.badge}</span>
          )}
        </Reveal>
      ))}
    </div>
    <SectionCta cta={process.cta} lang={t.lang} />
  </div>
</section>
