---
import Icon from '../components/Icon.astro'
import type { T } from '../content'
import { btnPrimary, btnGhost, kicker } from '../lib/ui'

interface Props {
  t: T
}

const { t } = Astro.props
const { hero } = t
const { flow } = hero
const rise = 'animate-rise motion-reduce:animate-none'
---

<header id={t.anchors.top} class="relative overflow-hidden pt-[clamp(56px,9vw,120px)] pb-[clamp(40px,6vw,72px)]">
  <div class="wrap grid items-center gap-[clamp(32px,5vw,72px)] lg:grid-cols-[1.1fr_0.9fr]">
    <!-- Centered while stacked (below lg), left-aligned beside the example card. -->
    <div class="relative z-2 flex flex-col items-center text-center lg:items-start lg:text-left">
      <h1 class={`m-0 max-w-[15ch] text-[clamp(38px,5vw,68px)] leading-[0.98] tracking-[-0.045em] hyphens-manual ${rise}`}>
        {hero.pre} <span class="text-grad">{hero.grad}</span> {hero.post}
      </h1>
      <p class={`mt-[clamp(18px,3vw,28px)] max-w-[44ch] text-[clamp(16px,1.7vw,19px)] leading-[1.55] text-ink-2 [animation-delay:0.1s] ${rise}`}>{hero.sub}</p>
      <div class={`mt-[clamp(24px,4vw,36px)] flex flex-wrap justify-center gap-3.5 lg:justify-start [animation-delay:0.2s] ${rise}`}>
        <a href={`#${t.anchors.contact}`} class={btnPrimary}>{hero.ctaPrimary} <Icon name="arrow" /></a>
        <a href={`#${t.anchors.examples}`} class={btnGhost}>{hero.ctaExamples}</a>
      </div>
      <p class={`mt-[18px] text-[13.5px] font-semibold text-ink-2 [animation-delay:0.25s] ${rise}`}>{hero.note}</p>
    </div>

    <!-- The hero's one authored motion: an order travelling through an automation, step by step.
         Rendered in its finished state; the script below animates it (not with reduced motion). -->
    <div
      class="card relative mx-auto w-full max-w-[520px] px-[22px] lg:mx-0 pt-[22px] pb-5 shadow-card animate-[rise_0.9s_0.3s_var(--ease-out-expo)_both] motion-reduce:animate-none lg:max-w-none"
      aria-label={flow.label}
      data-hero-flow
    >
      <div class="mb-2 flex flex-col gap-1 border-b-[1.5px] border-line pb-4">
        <span class={`${kicker} text-red`}>{flow.label}</span>
        <span class="font-display text-xl font-extrabold tracking-[-0.03em]">{flow.caption}</span>
      </div>
      <ol>
        {flow.steps.map((s, i) => (
          <li class="group is-done relative flex items-center gap-3.5 py-3 not-last:after:absolute not-last:after:top-[calc(50%+22px)] not-last:after:left-5 not-last:after:h-[calc(100%-42px)] not-last:after:w-[1.5px] not-last:after:bg-line-2">
            <span
              class="grid size-[42px] flex-none place-items-center rounded-xl border-[1.6px] border-dashed border-line-2 text-ink-2 transition-[background-color,border-color,color,scale,box-shadow] duration-500 ease-out-expo group-[.is-active]:scale-106 group-[.is-active]:animate-pulse-glow group-[.is-active]:border-red group-[.is-active]:text-red group-[.is-done]:border-solid group-[.is-done]:border-transparent group-[.is-done]:bg-grad group-[.is-done]:text-white group-[.is-done]:shadow-[0_8px_18px_var(--grad-glow)] motion-reduce:transition-none motion-reduce:group-[.is-active]:animate-none"
              aria-hidden="true"
            >
              <span class="font-display text-base font-extrabold">{i + 1}</span>
            </span>
            <span class="flex min-w-0 flex-col gap-0.5 opacity-50 transition-opacity duration-500 ease-out-expo group-[.is-active]:opacity-100 group-[.is-done]:opacity-100">
              <strong class="text-[15.5px] font-bold tracking-[-0.01em]">{s.t}</strong>
              <span class="text-[13.5px] text-ink-2">{s.d}</span>
            </span>
          </li>
        ))}
      </ol>
      <div class="group/done is-on mt-2.5 flex items-center gap-2.5 border-t-[1.5px] border-line pt-3.5 text-sm font-bold text-ink-3 transition-colors duration-400 [&.is-on]:text-ink" data-done>
        <span class="size-2.5 rounded-[2px] bg-line-2 transition-[background] duration-400 group-[.is-on]/done:bg-grad" aria-hidden="true"></span>
        {flow.done}
      </div>
    </div>
  </div>
</header>

<script>
  const flow = document.querySelector<HTMLElement>('[data-hero-flow]')
  if (flow && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    const steps = [...flow.querySelectorAll('li')]
    const done = flow.querySelector('[data-done]')!
    const total = steps.length
    const show = (step: number) => {
      steps.forEach((li, i) => {
        li.classList.toggle('is-done', i < step)
        li.classList.toggle('is-active', i === step)
      })
      done.classList.toggle('is-on', step >= total)
    }
    let current = 0
    show(0)
    window.setInterval(() => {
      // Hold the finished state for two ticks before starting over.
      current = current >= total + 2 ? 0 : current + 1
      show(Math.min(current, total))
    }, 1300)
  }
</script>
