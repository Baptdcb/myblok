---
// Minimal inline icons (stroke = currentColor).
import type { HTMLAttributes } from 'astro/types'

export type IconName = 'sun' | 'moon' | 'arrow' | 'menu' | 'repeat' | 'sheet' | 'bell' | 'puzzle' | 'shield'

interface Props extends HTMLAttributes<'svg'> {
  name: IconName
}

const { name, ...rest } = Astro.props
const size = { sun: 18, moon: 18, arrow: 16, menu: 20 }[name as string] ?? 22
const width = { sun: 1.8, moon: 1.8, arrow: 2.2, menu: 1.9 }[name as string] ?? 1.9
---

<svg width={size} height={size} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width={width} stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" {...rest}>
  {name === 'sun' && <><circle cx="12" cy="12" r="4" /><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" /></>}
  {name === 'moon' && <path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z" />}
  {name === 'arrow' && <path d="M5 12h14M13 6l6 6-6 6" />}
  {name === 'menu' && <path d="M4 7h16M4 12h16M4 17h16" />}
  {name === 'repeat' && <path d="M17 2.5 20 5.5 17 8.5M20 5.5H8a5 5 0 0 0-5 5v1M7 21.5 4 18.5 7 15.5M4 18.5h12a5 5 0 0 0 5-5v-1" />}
  {name === 'sheet' && <><rect x="3.5" y="4" width="17" height="16" rx="2" /><path d="M3.5 9.5h17M3.5 14.5h17M9.5 4v16" /></>}
  {name === 'bell' && <><path d="M6 16.5V11a6 6 0 0 1 12 0v5.5l1.5 2h-15z" /><path d="M10 20.5a2 2 0 0 0 4 0" /></>}
  {name === 'shield' && <><path d="M12 3 19 6v5c0 4.5-3 8.4-7 10-4-1.6-7-5.5-7-10V6z" /><path d="m9 12 2 2 4-4" /></>}
  {name === 'puzzle' && <path d="M9 4.5h3.2a1.6 1.6 0 0 1 1.55 2 1.6 1.6 0 0 0 1.95 1.95 1.6 1.6 0 0 1 2 1.55V13h-1.2a1.9 1.9 0 1 0 0 3.8H19v3.2a1.5 1.5 0 0 1-1.5 1.5h-3.7v-1.3a1.9 1.9 0 1 0-3.8 0V21.5H6a1.5 1.5 0 0 1-1.5-1.5v-3.7h1.3a1.9 1.9 0 1 0 0-3.8H4.5V9a1.5 1.5 0 0 1 1.5-1.5h1.7A1.6 1.6 0 0 0 9 4.5Z" />}
</svg>
