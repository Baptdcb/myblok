---
import { CONTACT_EMAIL, LEGAL, realisations, type T } from '../content'
import { pagePath, homeSection } from '../lib/routes'

interface Props {
  t: T
}

const { t } = Astro.props
const { footer, lang } = t
const navLabel = (key: string) => t.nav.links.find((l) => l.key === key)?.label
const sections: (keyof T['anchors'])[] = ['offer', 'examples', ...(realisations.length > 0 ? (['realisations'] as const) : []), 'faq']
const link = 'transition-colors hover:text-red'
---

<footer class="band border-t border-line pt-12 pb-10">
  <!-- Printed in reverse like the contact band above it on the home page: the page closes on ink. -->
  <div class="wrap">
    <div class="flex flex-col flex-wrap items-start justify-between gap-6 md:flex-row">
      <div>
        <div class="inline-flex items-center gap-2.5 font-display text-[19px] font-extrabold tracking-[-0.04em]">
          <img class="block size-7 flex-none object-contain" src="/logos/myblok.svg" alt="" aria-hidden="true" />
          <span>myblok</span>
        </div>
        <p class="mt-2.5 max-w-[30ch] text-sm text-ink-2">{footer.tagline}</p>
        <p class="mt-3.5 flex flex-wrap gap-x-4 gap-y-1.5 text-sm text-ink-2">
          <a href={`mailto:${CONTACT_EMAIL}`} class="font-bold text-red">{CONTACT_EMAIL}</a>
          <span>{footer.location}</span>
        </p>
      </div>
      <nav class="flex flex-col items-start gap-2.5 text-[13px] font-semibold text-ink-2 md:items-end" aria-label="Footer">
        {sections.map((key) => <a href={homeSection(lang, key)} class={link}>{navLabel(key)}</a>)}
        <a href={homeSection(lang, 'contact')} class={link}>{footer.contactLink}</a>
      </nav>
    </div>

    <div class="mt-[34px] flex flex-wrap justify-between gap-x-6 gap-y-2.5 border-t border-line pt-[18px] text-[12.5px] text-ink-3">
      <p>© {new Date().getFullYear()} myblok — {LEGAL.name}, {footer.owner}</p>
      <p class="flex gap-[18px] font-semibold">
        <a href={pagePath('legal', lang)} class={link}>{footer.legalLink}</a>
        <a href={pagePath('privacy', lang)} class={link}>{footer.privacyLink}</a>
      </p>
    </div>
  </div>
</footer>
