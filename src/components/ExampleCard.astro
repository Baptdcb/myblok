---
// One example as a card: drawing, tag, title, summary. The whole card is the link.
import Icon from './Icon.astro'
import Visual from './Visual.astro'
import type { Article, T } from '../content'
import { pagePath } from '../lib/routes'
import { focusRing, lift, tag } from '../lib/ui'

interface Props {
  article: Article
  t: T
}

const { article, t } = Astro.props
const a = article[t.lang]
---

<a class={`card group flex w-full flex-col overflow-hidden ${lift} ${focusRing}`} href={pagePath('article', t.lang, article.slug)}>
  <div class="block aspect-16/10 border-b border-line bg-grid px-4 py-3.5">
    <Visual
      name={article.visual}
      lang={t.lang}
      label={a.title}
      class="transition-transform duration-600 ease-out-expo group-hover:scale-[1.035] motion-reduce:transition-none"
    />
  </div>
  <div class="flex flex-1 flex-col px-[22px] pt-5 pb-5">
    <span class={tag}>{t.examples.tags[article.tag]}</span>
    <h3 class="mt-2.5 text-xl leading-[1.15] tracking-[-0.025em]">{a.title}</h3>
    <p class="mt-2.5 flex-1 text-[14.5px] leading-normal text-ink-2">{a.summary}</p>
    <p class="mt-3 text-[13px] leading-[1.45] font-semibold text-ink">{a.proof}</p>
    <span class="mt-4 flex items-center gap-2 text-sm font-bold transition-[color,gap] duration-300 ease-out-expo group-hover:gap-3 group-hover:text-red">
      {t.examples.read} <Icon name="arrow" />
    </span>
  </div>
</a>
