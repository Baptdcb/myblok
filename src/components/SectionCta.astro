---
// Closing call-to-action of a section, always pointing to the contact form.
import Reveal from './Reveal.astro'
import Icon from './Icon.astro'
import type { Lang } from '../content'
import { homeSection } from '../lib/routes'
import { btnPrimary } from '../lib/ui'

interface Props {
  cta: { text: string; button: string }
  lang: Lang
}

const { cta, lang } = Astro.props
---

<Reveal class="mt-[clamp(34px,5vw,56px)] flex flex-wrap items-center justify-between gap-5 border-t border-line pt-[clamp(28px,4vw,40px)]" delay={2}>
  <span class="font-display text-[clamp(17px,1.8vw,21px)] font-bold tracking-[-0.02em]">{cta.text}</span>
  <a href={homeSection(lang, 'contact')} class={btnPrimary}>{cta.button} <Icon name="arrow" /></a>
</Reveal>
