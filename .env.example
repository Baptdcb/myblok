# Server-side email configuration for Vercel Function + Resend
# Put real values in .env.local (local dev) and in Vercel Project Settings > Environment Variables.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxx
CONTACT_FROM_EMAIL=myblok <contact@myblok.fr>
CONTACT_TO_EMAIL=contact@myblok.fr

# Cloudflare Turnstile (anti-spam on the contact form)
# Site key is public (shipped to the browser), secret key stays server-side only.
# Get both at https://dash.cloudflare.com/ > Turnstile
VITE_TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
